pipeline {
    agent {
        docker{
            image 'docker-jenkin-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock' // mount Docker socket to access the host's Docker daemon
               
        }
    }

    stages {
        stage('build') {
            steps {
               checkout scmGit(branches: [[name: '*/main']], browser: github('https://github.com'), extensions: [sparseCheckout([[path: 'docker-with-jenkin-3tier']])], userRemoteConfigs: [[credentialsId: 'jenkin', url: 'https://github.com/kvnikhildev/Docker-Projects-.git']])
            }
        }

        stage('install_dependency_frontend'){
            steps{
                sh '''
                ls
                cd docker-with-jenkin-3tier/frontend
                npm install'''
            }
        }
        stage('install_dependency_backend'){
            steps{
                sh '''cd docker-with-jenkin-3tier/backend
                npm install'''
            }
        }

        stage('lint testing frontend'){
            steps{
                script {
                    def lint_frontend = sh(
                        script: 'cd docker-with-jenkin-3tier/frontend && npm run lint -- --format json --output-file eslint-frontend-report.json',
                        returnStatus: true
                    )
                    archiveArtifacts (
                    artifacts: 'docker-with-jenkin-3tier/frontend/eslint-frontend-report.json',
                    allowEmptyArchive:true)
                    if (lint_frontend !=0) {
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }
    

        stage('unit test -fronendend'){
            steps{
               sh 'cd docker-with-jenkin-3tier/frontend && mkdir -p reports && npm run test -- --reporter=default --reporter=junit --outputFile.junit=reports/frontend-junit.xml'
            }
        }       

        stage('lint testing backend'){
            steps{
                script {
                    def eslint_backend = sh(
                        script: 'cd docker-with-jenkin-3tier/backend && npm run lint -- --format=json --output-file eslint-backend-report.json' ,
                        returnStatus: true )
                        archiveArtifacts (
                        artifacts: 'docker-with-jenkin-3tier/backend/eslint-backend-report.json',
                        allowEmptyArchive: true)
                    if (eslint_backend != 0){
                        currentBuild.result = 'UNSTABLE'
                    }
                }
             }
        }

        stage('docker image build frontend'){
            steps{
                sh """
                cd docker-with-jenkin-3tier/frontend 
                docker build -t frontend:v${BUILD.NUMBER} .
                """
            }
        }
        stage('doocker image build backend'){
            steps{
            sh"""
            cd docker-with-jenkin-3tier/backend
            docker build -t backend:v${BUILD.NUMBER} .
            """
            }
        }
        
    }

        
    post {
        always{
             emailext(
                to: 'kvnikhill@gmail.com',
                subject: "Jenkin Report #${BUILD_NUMBER}",
                body:
                    """
                    Project: ${env.JOB_NAME},
                    Build Number: ${BUILD_NUMBER},
                    Build Status: ${currentBuild.currentResult},
                    Build URL: ${BUILD_URL},
                    """,
                    attachmentsPattern:'docker-with-jenkin-3tier/frontend/reports/frontend-junit.xml ,docker-with-jenkin-3tier/frontend/eslint-frontend-report.json, docker-with-jenkin-3tier/backend/eslint-backend-report.json')
        }
                success {
                    echo 'pepeline is sucessfull'
                }
                failure {
                    echo 'pipeline is faild'
                }
                unstable {
                    echo 'unstable pipeline'
                }
        
    }
}
    
      

